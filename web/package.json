{
  "name": "facescan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/copy_live_assets.mjs --optional && vite",
    "build": "node scripts/copy_live_assets.mjs && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium-mobile --project=webkit-mobile --project=chromium-camera",
    "e2e:real": "E2E_REAL_STACK=1 playwright test --project=real-stack --project=real-stack-webkit --workers=1",
    "screenshots": "playwright test --project=screenshots",
    "gen:types": "openapi-typescript ../api/openapi.json -o src/api/openapi.d.ts",
    "check:types": "openapi-typescript ../api/openapi.json -o .openapi-check.d.ts && diff -u src/api/openapi.d.ts .openapi-check.d.ts && rm .openapi-check.d.ts",
    "fonts": "node scripts/copy_fonts.mjs",
    "live-assets": "node scripts/copy_live_assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "exifr": "7.1.3",
    "i18next": "26.4.2",
    "libheif-js": "1.23.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@msw/playwright": "0.6.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
